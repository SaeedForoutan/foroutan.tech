---
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { projects } from '../lib/projects';
import { site } from '../lib/site';
import { slugifyTag } from '../lib/tags';
---

<Layout
  title={`Projects — ${site.name}`}
  description={site.projectsTagline}
  canonicalPath="/projects/"
>
  <main class="content-shell" data-pagefind-body>
    <section class="page-hero">
      <h1 class="visually-hidden">Projects</h1>
      <TypedLede text={site.projectsTagline} />
    </section>

    <section class="section" aria-label="Projects">
      {projects.length === 0 ? (
        <p class="empty-note">Nothing listed yet, check back soon.</p>
      ) : (
        <div class="post-list">
          {projects.map((project) => (
            <article class="post-card">
              <a class="post-card-link" href={project.url} target="_blank" rel="noopener">
                <div>
                  <h2>{project.name}</h2>
                  <p>{project.description}</p>
                  {project.period && <p class="post-card-meta">{project.period}</p>}
                </div>
              </a>
              {/* Chips and the demo link are siblings of the card link, not
                  children: anchors can't nest. */}
              {(project.tags?.length || project.demoUrl) && (
                <p class="post-tags">
                  {project.demoUrl && (
                    <a class="tag" href={project.demoUrl} target="_blank" rel="noopener">
                      live
                    </a>
                  )}
                  {project.tags?.filter((tag) => slugifyTag(tag) !== '').map((tag) => (
                    <a class="tag" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>

---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import Layout from '../components/Layout.astro';
import TypedLede from '../components/TypedLede.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { formatPostDate, postSlug } from '../lib/posts';
import { site } from '../lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: site.url,
  sameAs: [site.github, site.linkedin],
  // Escape < so no value can ever close the inline <script> tag.
}).replace(/</g, '\\u003c');
---

<Layout title={site.name} description={site.tagline} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema} />
  <main class="content-shell">
    <div class="page-hero">
      <h1 class="visually-hidden">Home</h1>
      <div class="hero-split">
        <TypedLede text={site.tagline} />
        <Image
          class="hero-portrait"
          src={portrait}
          alt={site.name}
          widths={[300, 450, 606]}
          sizes="(max-width: 860px) 240px, 400px"
          loading="eager"
        />
      </div>
    </div>

    <section class="section" aria-label="Site sections">
      <nav class="commit-tree" aria-label="Site sections">
        <a class="commit-tree-head" href="/blog/" title="All posts">Blog</a>
        {posts.map((post) => (
          <a href={`/blog/${postSlug(post)}/`}>
            {post.data.title}
            <span class="commit-tree-date">{formatPostDate(post.data.date)}</span>
          </a>
        ))}
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
      </nav>
      {posts.length === 0 && (
        <p class="empty-note">No posts yet, check back soon.</p>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>
